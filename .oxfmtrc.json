  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "endOfLine": "lf",
  "ignorePatterns": [".codex/**", "src-tauri/target/**", "src-tauri/gen/schemas/**"]
}
