{
  "name": "agent-dock",
  "private": true,
  "version": "0.1.0",
  "description": "claude code agent view gui editor",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "prepare": "panda codegen",
    "codegen": "panda codegen",
    "dev": "vite",
    "lint": "oxlint . --deny-warnings && cd src-tauri && cargo clippy -- -D warnings",
    "lint:ts": "oxlint . --deny-warnings",
    "lint:rust": "cd src-tauri && cargo clippy -- -D warnings",
    "format": "oxfmt \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.css\" \"*.ts\" \"*.json\" \".*.json\" index.html --no-error-on-unmatched-pattern && cd src-tauri && cargo fmt",
    "format:check": "oxfmt \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.css\" \"*.ts\" \"*.json\" \".*.json\" index.html --check --no-error-on-unmatched-pattern && cd src-tauri && cargo fmt --check",
    "format:ts": "oxfmt \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.css\" \"*.ts\" \"*.json\" \".*.json\" index.html --no-error-on-unmatched-pattern",
    "format:ts:check": "oxfmt \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.css\" \"*.ts\" \"*.json\" \".*.json\" index.html --check --no-error-on-unmatched-pattern",
    "format:rust": "cd src-tauri && cargo fmt",
    "format:rust:check": "cd src-tauri && cargo fmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "panda codegen && tsc --noEmit",
    "build": "panda codegen && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@suspensive/react": "^3.21.3",
    "@suspensive/react-query": "npm:@suspensive/react-query-5@^3.21.3",
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "^2.11.1",
    "jotai": "^2.20.1",
    "overlay-kit": "^1.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.11.4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "postcss": "^8.5.16",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  }
}
